# macOS
.DS_Store
._*

# Poster runtime state — local to whichever machine runs the cron.
# state.json is the poster's memory of every film it has considered;
# losing it means a backfill would re-offer everything. Back it up
# somewhere, but it doesn't belong in version control — it changes on
# every run and would make the history unreadable.
poster/state.json
poster/queue.json

# …but poster/state.backup.json IS tracked. Same data, sorted and one id
# per line, so a run adds a few readable lines instead of rewriting one
# enormous one. It is the only copy of the poster's memory that survives
# this machine. Restore with:
#   cp poster/state.backup.json poster/state.json

# Working art files — PSDs, exports, anything being made rather than
# served. Keep them outside the repo; a 169 MB Photoshop file was swept
# in by `git add -A` and rejected by GitHub's 100 MB limit.
public/
*.psd

# Scratch SPARQL
*.rq

# Generated preview
preview.html

# Logs and backups.
#
# `*.before-recheck` alone was too narrow: every other rescue copy —
# .before-refill, .before-tmdbids, queue.json.old-check — was committed
# instead, putting 3.2 MB of duplicated archive into the history. They are
# rollback points for one afternoon, not versioned artefacts. Name a new
# backup `<file>.before-<thing>` and it stays local, which is where a
# backup taken against a run that is about to write belongs.
*.log
*.before-*
*.old-check

# Credentials live in ~/.picture-wrap.env, outside this folder entirely.
.env
.env.*

# Dev-only. The site still ships no dependencies.
node_modules/

# Rotating queue snapshots, taken while a long backfill runs.
poster/snapshots/

# A pass's raw output. One year is 3.6 MB of evidence and the corpus is
# 127 of them, so this is roughly half a gigabyte of JSONL — the working
# out, not the work. Where it should finally live is undecided: the whole
# argument for keeping it is that a rule change becomes a re-decision
# instead of a re-fetch, and that argument dies if it only ever exists on
# one laptop. Until that is settled it stays out of the history.
pass/
